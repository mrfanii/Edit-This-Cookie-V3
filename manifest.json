{
  "name": "EditThisCookie (V3)",
  "version": "3.1.0",
  "description": "__MSG_editThis_description__",
  "icons": {
    "16": "img/icon_16x16.png",
    "48": "img/icon_48x48.png",
    "128": "img/icon_128x128.png"
  },
  "default_locale": "en",
  "action": {
    "default_icon": {
      "19": "img/icon_19x19.png",
      "38": "img/icon_38x38.png"
    },
    "default_title": "EditThisCookie",
    "default_popup": "pages/popup.html"
  },
  "devtools_page": "/pages/devtools-page.html",
  "background": {
    "service_worker": "/js/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/content_statistics.js"],
      "run_at": "document_start"
    }
  ],
  "options_page": "pages/options_main_page.html",
  "permissions": ["tabs", "cookies", "contextMenus", "unlimitedStorage", "storage", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "minimum_chrome_version": "119",
  "manifest_version": 3
}
